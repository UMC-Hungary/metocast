{
  "name": "metocast",
  "version": "2.1.0",
  "description": "Metocast — livestream control desktop application (workspace root)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @metocast/${METOCAST_UI:-classic} dev",
    "build": "node scripts/build-ui.mjs",
    "check": "pnpm -r --if-present run check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:server": "cargo build -p metocast-server --bin metocast-server",
    "test:e2e": "vitest run --config vitest.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte": "^5.56.8",
    "svelte-eslint-parser": "^1.4.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.1.0",
    "ws": "^8.19.0"
  }
}
