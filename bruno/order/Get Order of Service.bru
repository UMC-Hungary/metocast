meta {
  name: Get Order of Service
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/events/{{eventId}}/order
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  The event's steps in order: `song` (a deck, or none for a verse sung without slides), `bible` (the event's `textus` or `leckio`),
  `announcements` (its `notes` are the bullet points, one per line, shown as slides) and `block` (no slides). A new event starts with the default template; a song placeholder
  (*Song 1*…) has no `deckPath` until one is picked.
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
