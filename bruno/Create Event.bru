meta {
  name: Create Event
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "title": "Sunday Service",
    "date_time": "2026-02-25T00:12:19.843Z",
    "speaker": "Pastor"
  }
}

docs {
  Creates the event with the default Order of Service: Welcome message, Song 1, Song 2, Lekció,
  Song 3, Textus, Preaching, Song 4, Hirdetések, áldás, Song 4 last part. The songs have no deck
  until one is picked. Read the steps with *order / Get Order of Service*.
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
}
