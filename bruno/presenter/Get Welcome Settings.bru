meta {
  name: Get Welcome Settings
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/presenter/welcome
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  The welcome screen a text Order of Service step shows in the web presenter: a photo, the logo,
  the greeting (the step's title), its notes or else `subtitle`, and `churchName` with the event's
  date. Each month has its photo (1 = January). `hasLogo` and `replacedPhotos` say what was
  uploaded. `GET /api/presenter/welcome/preview/{1-12}` returns a month's slide as SVG.
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
