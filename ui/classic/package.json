{
  "name": "@metocast/classic",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Metocast classic rendering UI — the original SvelteKit control surface.",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@metocast/core-client": "workspace:*",
    "lucide-svelte": "^0.575.0",
    "svelte-i18n": "^4.0.1",
    "svelte-sonner": "^1.0.7",
    "tauri-plugin-liquid-glass-api": "^0.1.6"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "postcss": "^8.5.6",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "~5.9.3",
    "vite": "^8.2.1"
  }
}
