    "Textus" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textus"
          }
        }
      }
    },
    "The Blackmagic camera and Middle Control may drive the same camera, so it could be started twice." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Blackmagic kamera és a Middle Control ugyanazt a kamerát vezérelheti, így kétszer is elindulhat."
          }
        }
      }
    },
    "The Claude Desktop extension is missing from this build." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebből a buildből hiányzik a Claude Desktop-bővítmény."
          }
        }
      }
    },
    "The Media page needs this Mac's server." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Média oldalhoz ennek a Macnek a szervere kell."
          }
        }
      }
    },
    "The Metocast server is missing from the app bundle." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Metocast szerver hiányzik az alkalmazásból."
          }
        }
      }
    },
    "The RØDECaster has no SD card or USB drive to record to." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A RØDECasterben nincs SD-kártya vagy USB-meghajtó, amire rögzíthetne."
          }
        }
      }
    },
    "The RØDECaster isn't connected." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A RØDECaster nincs csatlakozva."
          }
        }
      }
    },
    "The RØDECaster's multitrack USB audio isn't reaching this Mac. Connect USB 1 and enable multitrack." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A RØDECaster többsávos USB-hangja nem érkezik meg erre a Macre. Csatlakoztasd az USB 1-et, és kapcsold be a többsávos módot."
          }
        }
      }
    },
    "The app is missing its copy of %@." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazásból hiányzik ez a fájl: %@."
          }
        }
      }
    },
    "The bridge is missing from this build." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebből a buildből hiányzik a híd."
          }
        }
      }
    },
    "The camera's clock is %@ ahead of the recorder's" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kamera órája %@ értékkel siet a felvevőéhez képest"
          }
        }
      }
    },
    "The camera's clock is %@ behind the recorder's" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kamera órája %@ értékkel késik a felvevőéhez képest"
          }
        }
      }
    },
    "The captions OBS shows over the stream, and the OBS sources the server warns about when one goes missing." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az OBS által a közvetítés fölött mutatott feliratok, és azok az OBS-források, amelyek eltűnésére a szerver figyelmeztet."
          }
        }
      }
    },
    "The clocks" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az órák"
          }
        }
      }
    },
    "The copied text contains this server's access token. Paste it into your agent's settings and nowhere else. Save the switches above first." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A másolt szöveg tartalmazza ennek a szervernek a hozzáférési tokenjét. Csak az ügynököd beállításaiba illeszd be. Előbb mentsd a fenti kapcsolókat."
          }
        }
      }
    },
    "The core runs on another machine. Its output is in the Server Log on the Mac hosting it." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A core egy másik gépen fut. A kimenete az azt futtató Mac Szervernaplójában található."
          }
        }
      }
    },
    "The device scan timed out. Check the connector and try again." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszközkeresés túllépte az időkorlátot. Ellenőrizd a csatlakozót, és próbáld újra."
          }
        }
      }
    },
    "The first job downloads jive-vocals (about 53 MB)." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az első feladat letölti a jive-vocals programot (kb. 53 MB)."
          }
        }
      }
    },
    "The jive-vocals path in Media Processing doesn't point to a program" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Médiafeldolgozásban megadott jive-vocals útvonal nem programra mutat"
          }
        }
      }
    },
    "The last upload failed." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az utolsó feltöltés sikertelen volt."
          }
        }
      }
    },
    "The log is empty." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A napló üres."
          }
        }
      }
    },
    "The original and the cleaned-up text are both removed. This cannot be undone." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eredeti és a tisztított szöveg is törlődik. Ez nem vonható vissza."
          }
        }
      }
    },
    "The overlay shows the current event's title, which the server fills in." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A réteg az aktuális esemény címét mutatja, amelyet a szerver tölt ki."
          }
        }
      }
    },
    "The recording folder doesn't exist on the server's Mac. Set it in Settings → Connectors → RØDECaster." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A felvételek mappája nem létezik a szerver Macjén. Állítsd be a Beállítások → Csatlakozók → RØDECaster alatt."
          }
        }
      }
    },
    "The rule fires when any of these happens." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szabály akkor fut le, amikor ezek közül bármelyik bekövetkezik."
          }
        }
      }
    },
    "The rule won't fire again until the cooldown has passed." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szabály nem fut le újra, amíg le nem telik a várakozási idő."
          }
        }
      }
    },
    "The server address is invalid." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver címe érvénytelen."
          }
        }
      }
    },
    "The server connection was lost." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megszakadt a kapcsolat a szerverrel."
          }
        }
      }
    },
    "The server couldn't be reached." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver nem érhető el."
          }
        }
      }
    },
    "The server did not send a usable sign-in address." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver nem küldött használható bejelentkezési címet."
          }
        }
      }
    },
    "The server didn't start within 10 minutes. See the server log." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver 10 percen belül nem indult el. Nézd meg a szervernaplót."
          }
        }
      }
    },
    "The server refused this request (HTTP %u)." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver elutasította a kérést (HTTP %u)."
          }
        }
      }
    },
    "The server rejected this device's token." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver elutasította ennek az eszköznek a tokenjét."
          }
        }
      }
    },
    "The server rejected this device's token. Remove access in Settings and connect again." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver elutasította ennek az eszköznek a tokenjét. Távolítsd el a hozzáférést a Beállításokban, és csatlakozz újra."
          }
        }
      }
    },
    "The server rejected this token." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver elutasította ezt a tokent."
          }
        }
      }
    },
    "The server stopped. %@" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver leállt. %@"
          }
        }
      }
    },
    "The server warns when a watched source stops appearing in OBS." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver figyelmeztet, ha egy figyelt forrás eltűnik az OBS-ből."
          }
        }
      }
    },
    "The server's answer didn't match what this app expects." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver válasza nem az, amit ez az alkalmazás vár."
          }
        }
      }
    },
    "The songs, readings and parts of the service, in order. Step through them on the Live page." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az istentisztelet énekei, igeolvasásai és részei, sorrendben. Az Élő oldalon léptethetsz végig rajtuk."
          }
        }
      }
    },
    "The speaker's lips" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beszélő szájmozgása"
          }
        }
      }
    },
    "The steps after this one start once the camera has reached the preset." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ezt követő lépések akkor indulnak, amikor a kamera elérte a presetet."
          }
        }
      }
    },
    "The steps after this one start right away." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ezt követő lépések azonnal indulnak."
          }
        }
      }
    },
    "The video's own sound" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A videó saját hangja"
          }
        }
      }
    },
    "The video's sound" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A videó hangja"
          }
        }
      }
    },
    "Then move the camera" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utána a kamera mozgatása"
          }
        }
      }
    },
    "This Mac controls a Metocast server running on another computer." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a Mac egy másik számítógépen futó Metocast szervert vezérel."
          }
        }
      }
    },
    "This Mac runs Metocast: the database, connectors and schedules. Other devices connect to it." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen a Macen fut a Metocast: az adatbázis, a csatlakozók és az ütemezések. A többi eszköz ehhez csatlakozik."
          }
        }
      }
    },
    "This Mac runs the core as a helper, which keeps its output in Settings → Server Log." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a Mac segédprogramként futtatja a core-t, amelynek kimenete a Beállítások → Szervernapló alatt látható."
          }
        }
      }
    },
    "This broadcast has ended. Schedule a new one." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a közvetítés véget ért. Ütemezz egy újat."
          }
        }
      }
    },
    "This can't be undone." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez nem vonható vissza."
          }
        }
      }
    },
    "This device forgets the server and its token." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz elfelejti a szervert és a tokenjét."
          }
        }
      }
    },
    "This device will stop using its current server." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz nem használja tovább a jelenlegi szerverét."
          }
        }
      }
    },
    "This event has no %@ broadcast yet." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennek az eseménynek még nincs közvetítése itt: %@."
          }
        }
      }
    },
    "This folder has no PowerPoint decks." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebben a mappában nincsenek PowerPoint-diasorok."
          }
        }
      }
    },
    "This really records and moves cameras: %@" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez valóban rögzít és mozgatja a kamerákat: %@"
          }
        }
      }
    },
    "This stops the %@ for everyone." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez mindenkinél leállítja: %@."
          }
        }
      }
    },
    "Timed to the video or to the recording: Metocast matches the lines with the voice, saves an .srt beside the video, and sends it with the YouTube and Facebook uploads." : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A videóhoz vagy a felvételhez időzítve: a Metocast a beszédhanghoz igazítja a sorokat, a videó mellé ment egy .srt fájlt, és elküldi a YouTube- és Facebook-feltöltésekkel."
          }
        }
      }
    },
    "Tint" : {
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Árnyalat"
          }
        }
      }
    },
    "Title" : {
      "localizations" : {
